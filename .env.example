# Kafka
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_TOPIC=market.raw
KAFKA_NEWS_TOPIC=market.news
KAFKA_SOCIAL_TOPIC=market.social

# PostgreSQL
POSTGRES_HOST=localhost
POSTGRES_PORT=5433
POSTGRES_USER=trading
POSTGRES_PASSWORD=trading
POSTGRES_DB=trading_signals

# Symbols to track (comma-separated)
SYMBOLS=AAPL,MSFT,GOOGL,TSLA,BTC-USD,ETH-USD,EUR-USD

# Producer intervals (seconds)
PRODUCER_INTERVAL_SECONDS=30
NEWS_INTERVAL_SECONDS=300
TWEET_INTERVAL_SECONDS=120

# Per-symbol fetch limits
NEWS_MAX_PER_SYMBOL=5
TWEETS_MAX_PER_SYMBOL=10

# Twitter/X API v2 — required for tweet ingestion
# Get a Bearer Token at https://developer.x.com/
TWITTER_BEARER_TOKEN=

# Feature engineering
MIN_ROWS_FOR_FEATURES=20

# Sentiment analysis
FINBERT_MODEL=ProsusAI/finbert
SENTIMENT_BATCH_SIZE=16

# Label generation
LABEL_LOOKAHEAD_ROWS=5
LABEL_BUY_THRESHOLD=2.0
LABEL_SELL_THRESHOLD=-2.0

# Sequence classifier (Phase 3)
ML_WINDOW_SIZE=24
ML_TRAIN_RATIO=0.8
ML_HIDDEN_SIZE=64
ML_NUM_LAYERS=2
ML_SYMBOL_EMBED_DIM=8
ML_DROPOUT=0.3
ML_BATCH_SIZE=32
ML_EPOCHS=50
ML_LEARNING_RATE=0.001
ML_FOCAL_GAMMA=2.0
ML_EARLY_STOP_PATIENCE=8
ML_SIGNAL_CONFIDENCE=0.8
ML_MODELS_DIR=models/checkpoints

# API (Phase 4)
API_HOST=0.0.0.0
API_PORT=8000
API_CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://127.0.0.1:5173
API_RELOAD=1
